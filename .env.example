# DSPy/LiteLLMが対応するモデル識別子を指定します。
# TASK_MODELには、比較的小さく安価なモデルを利用できます。
TASK_MODEL=openai/REPLACE_WITH_YOUR_TASK_MODEL

# Reflectionには、可能であればTASK_MODELより強いモデルを指定します。
# 未指定の場合はTASK_MODELが再利用されます。
REFLECTION_MODEL=openai/REPLACE_WITH_YOUR_REFLECTION_MODEL

# 利用するプロバイダーに対応するAPIキーを設定します。
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY
# ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_KEY
# GEMINI_API_KEY=REPLACE_WITH_YOUR_KEY

# 最初はlight、並列数1または2を推奨します。
GEPA_BUDGET=light
GEPA_THREADS=2

